# MySQL connection string, e.g. mysql://user:password@127.0.0.1:3306/aqa
DATABASE_URL=

# At least 32 characters, used to encrypt the admin session cookie
SESSION_SECRET=

# Seed-only: creates the first admin user on `npx prisma db seed`
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Public site URL, no trailing slash — used for canonical URLs, sitemap, JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP (Hostinger: create a mailbox in hPanel > Emails, host is smtp.hostinger.com).
# Leave blank in local dev to log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
